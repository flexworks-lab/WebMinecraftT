{
  "name": "webminecraft",
  "version": "1.0.0",
  "description": "Minecraft-style browser game with an optional multiplayer server",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/start.js",
    "electron:dev": "vite & electron .",
    "electron:build": "npm run build && electron-builder --win --x64 --publish never"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "three": "^0.185.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.5"
  },
  "build": {
    "appId": "com.webminecraft.game",
    "productName": "WebMinecraftT",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "WebMinecraftT-Setup-${version}.${ext}"
    }
  }
}

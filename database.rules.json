{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "worlds": {
          "$seed": {
            ".validate": "newData.hasChildren(['seed', 'name', 'createdAt', 'updatedAt']) && newData.child('seed').isNumber() && newData.child('name').isString() && newData.child('name').val().length <= 40"
          }
        },
        "worldData": {
          "$seed": {
            "$chunk": {
              ".validate": "newData.hasChildren(['blocks', 'updatedAt'])"
            }
          }
        },
        "deletedWorlds": {
          "$seed": {
            ".validate": "newData.hasChildren(['seed', 'deletedAt']) && newData.child('seed').isNumber()"
          }
        }
      }
    },
    "publicProfiles": {
      ".read": "auth != null",
      ".indexOn": ["friendCode"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "friendRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$requestId": {
          ".write": "auth != null && (auth.uid === $uid || (newData.exists() && newData.child('fromUid').val() === auth.uid))"
        }
      }
    },
    "sentFriendRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$requestId": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$friendUid": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $friendUid)"
        }
      }
    }
  }
}
